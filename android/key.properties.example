# Copy this file to `android/key.properties` and fill in your real keystore
# details. `key.properties` is git-ignored — never commit it.
#
# Generate a keystore once with:
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias upload
# Then place the .jks file under ../keys/ (see keys/README.md).

storeFile=../keys/upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
