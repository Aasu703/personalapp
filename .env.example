# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real secrets. See keys/README.md
# for where the actual key files referenced below should live.

# ---------------------------------------------------------------------------
# Android / Google Play Console
# ---------------------------------------------------------------------------
# Service-account JSON key: Play Console > Setup > API access > service account.
PLAY_STORE_JSON_KEY_PATH=keys/play-store-key.json

# Release signing keystore (created once with `keytool -genkey ...`).
ANDROID_KEYSTORE_PATH=keys/upload-keystore.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=

# ---------------------------------------------------------------------------
# iOS / App Store Connect
# ---------------------------------------------------------------------------
# API key: App Store Connect > Users and Access > Integrations > App Store Connect API.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_API_KEY_PATH=keys/AuthKey.p8
APPLE_TEAM_ID=
APP_STORE_CONNECT_TEAM_ID=
APPLE_ID=

# ---------------------------------------------------------------------------
# fastlane behaviour
# ---------------------------------------------------------------------------
# Set to "false" to call the system `flutter` instead of `fvm flutter`.
FVM=true

# ---------------------------------------------------------------------------
# Firebase configuration (generated via `flutterfire configure`)
# ---------------------------------------------------------------------------
# See https://firebase.google.com/docs/flutter/setup#configure-firebase-in-your-app
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=

# ---------------------------------------------------------------------------
# Supabase configuration (public URL and anon key)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Cloudinary configuration (unsigned upload preset)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

